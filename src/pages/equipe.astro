---
import Layout from "~/layouts/PageLayout.astro";
import { getAllMembers } from "~/utils/api";
import Membres from "~/components/blog/Membres.astro";
import { Image } from "astro:assets";
import teamBanner from "~/assets/images/realisation-banner.jpg";

const metadata = {
  title: 'Equipe - AfricTivistes CitizenLab Bénin',
  description: "Découvrez les membres et l'univers de l'équipe CitizenLab Bénin : des talents engagés pour renforcer la participation citoyenne.",
};

const members = await getAllMembers();
---

<Layout metadata={metadata}>
  <!-- Hero Banner -->
  <section class="relative isolate overflow-hidden h-[60vh] min-h-[400px]">
    <div class="absolute inset-0">
      <Image
        src={teamBanner}
        alt="Équipe CitizenLab Bénin"
        class="h-full w-full object-cover"
        width={1920}
        height={960}
        loading="eager"
        decoding="async"
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/70 to-black/40"></div>

    <div class="relative z-10 mx-auto flex h-full max-w-6xl flex-col justify-center gap-4 px-6 text-white lg:px-8">
      <p class="text-xs uppercase tracking-widest text-green-300 font-medium">Notre équipe</p>
      <h1 class="text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">
        Une équipe engagée au service de la participation citoyenne
      </h1>
      <p class="max-w-3xl text-base text-slate-200 sm:text-lg leading-relaxed">
        CitizenLab Bénin fédère une communauté de talents complémentaires — stratèges, créateurs de contenu, formateurs et activistes —
        réunis pour développer des solutions innovantes et renforcer la démocratie participative.
      </p>
    </div>
  </section>

  <!-- Values Section -->
  <section class="bg-white py-14">
    <div class="mx-auto max-w-6xl px-6 lg:px-8">
      <span class="inline-flex items-center rounded-full bg-green-50 border border-green-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-green-800 mb-4">
        Notre ADN
      </span>
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
        L'humain au centre, l'impact comme horizon
      </h2>
      <p class="text-sm text-gray-500 leading-relaxed max-w-3xl">
        Notre équipe se construit autour de valeurs fortes : rigueur citoyenne, inclusion, innovation et partage.
        Nous cultivons un environnement collaboratif où chaque membre peut exprimer son expertise pour amplifier notre action commune.
      </p>
    </div>
  </section>

  <!-- Team Members -->
  <section id="team" class="bg-gray-50 py-16">
    <div class="mx-auto max-w-6xl px-6 lg:px-8">
      <div class="mb-10">
        <p class="text-xs uppercase tracking-widest text-green-700 font-medium mb-2">Esprit d'équipe</p>
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900">
          Des acteurs engagés pour transformer le quotidien citoyen
        </h2>
      </div>
      <Membres team={members} />
    </div>
  </section>
</Layout>