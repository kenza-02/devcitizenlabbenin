---
import Layout from "~/layouts/PageLayout.astro";
import { Image } from "astro:assets";
import defaultImg from "~/assets/images/default.png";
import projetcours from "~/assets/images/projet-banner-1.jpg";
import { getAllProjets } from "~/utils/api";
import {
  FaCompass,
  FaUsers,
  FaCubes,
  FaFlask,
  FaSyncAlt,
  FaRocket,
} from "react-icons/fa";

const metadata = {
  title: "Projets - AfricTivistes CitizenLab Bénin",
  description:
    "Découvrez nos projets en cours, nos prototypes et nos impacts sur le terrain pour renforcer la participation citoyenne au Bénin.",
  ignoreTitleTemplate: true,
};

const wpProjets = await getAllProjets();

const projets = wpProjets.map((post: any, index: number) => {
  const cleanDescription =
    post.excerpt
      ?.replace(/<[^>]*>/g, "")
      ?.replace(/&nbsp;/g, " ")
      ?.replace(/&#8230;/g, "...")
      ?.trim() || "";

  return {
    slug: post.slug,
    titre: post.title,
    description: cleanDescription,
    categorie: post.categories?.nodes?.[0]?.name ?? "Projet",
    statut: "En cours",
    statutDetail: post.categories?.nodes?.[1]?.name ?? "En développement",
    image: post.featuredImage?.node?.mediaItemUrl || defaultImg,
    imagePosition: index % 2 === 0 ? "left" : "right",
    date: new Date(post.date).toLocaleDateString("fr-FR", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }),
  };
});

const etapes = [
  {
    nom: "Exploration",
    description: "Analyse des besoins et du contexte",
    icon: FaCompass,
  },
  {
    nom: "Co-conception",
    description: "Conception collaborative avec les parties prenantes",
    icon: FaUsers,
  },
  {
    nom: "Prototypage",
    description: "Création de la première version du projet",
    icon: FaCubes,
  },
  {
    nom: "Test sur le terrain",
    description: "Validation avec les communautés ciblées",
    icon: FaFlask,
  },
  {
    nom: "Amélioration",
    description: "Itération et ajustements basés sur les retours",
    icon: FaSyncAlt,
  },
  {
    nom: "Déploiement",
    description: "Préparation au lancement à grande échelle",
    icon: FaRocket,
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero Banner -->
  <section class="relative isolate overflow-hidden h-[60vh] min-h-[400px]">
    <div class="absolute inset-0">
      <Image
        src={projetcours}
        alt="Bannière Projets"
        width={1920}
        height={800}
        class="h-full w-full object-cover"
      />
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/70 to-black/40"
    >
    </div>

    <div
      class="relative mx-auto max-w-6xl flex h-full flex-col items-start justify-center gap-4 px-6 text-white lg:px-8"
    >
      <h1 class="text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">
        Des solutions innovantes pour renforcer la participation citoyenne
      </h1>
    </div>
  </section>

  <!-- Étapes du projet -->
  <section class="bg-white py-14">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="py-4">
        <p class="text-base text-gray-900 sm:text-lg leading-relaxed">
          Chez AfricTivistes CitizenLab Bénin, nous développons et expérimentons
          des outils numériques pour améliorer la transparence publique et
          favoriser la collaboration entre communautés, institutions et acteurs
          sociaux.
        </p>
      </div>
      <h2 class="text-xl font-semibold text-gray-900 mb-2">
        Les étapes de chaque projet
      </h2>
      <p class="text-sm text-gray-500 mb-10">
        Chaque projet suit un processus structuré de l'idée au déploiement.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {
          etapes.map((etape, index) => (
            <div class="relative flex flex-col items-center text-center">
              <div class="w-14 h-14 rounded-2xl bg-green-50 border border-green-100 flex items-center justify-center text-green-700 mb-3">
                <etape.icon className="w-6 h-6" />
              </div>
              <span class="text-xs font-medium text-green-800 bg-green-50 px-2 py-0.5 rounded-full mb-1.5">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="text-sm font-semibold text-gray-900 mb-1">
                {etape.nom}
              </h3>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Projets en cours -->
  <section class="bg-gray-50 py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">
          Projets en cours
        </h2>
        <div class="h-1 w-24 bg-primary mb-4 rounded-full"></div>
        <p class="text-sm text-gray-500 max-auto leading-relaxed">
          AfricTivistes CitizenLab Bénin mène actuellement plusieurs projets
          pilotes axés sur le numérique, la participation citoyenne,
          l'environnement et l'innovation sociale. Chaque projet inclut des
          phases de prototypage, de test et de validation avec les communautés.
        </p>
      </div>

      {
        projets.length === 0 ? (
          <div class="text-center py-12">
            <p class="text-sm text-gray-500">
              Aucun projet disponible pour le moment.
            </p>
          </div>
        ) : (
          <div class="space-y-6">
            {projets.map((projet, index) => (
              <div class="overflow-hidden rounded-2xl bg-white border border-gray-100 hover:border-green-300 shadow-sm hover:shadow-lg transition-all duration-300">
                <div
                  class={`flex flex-col lg:flex-row ${projet.imagePosition === "right" ? "lg:flex-row-reverse" : ""}`}
                >
                  <div class="relative h-56 lg:h-auto lg:w-1/2 overflow-hidden">
                    {typeof projet.image === "string" ? (
                      <img
                        src={projet.image}
                        alt={projet.titre}
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    ) : (
                      <Image
                        src={projet.image}
                        alt={projet.titre}
                        width={600}
                        height={400}
                        class="h-full w-full object-cover"
                      />
                    )}
                    <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-xs font-semibold text-green-800 uppercase tracking-wider px-3 py-1 rounded-full">
                      {projet.categorie}
                    </span>
                  </div>

                  <div class="flex-1 p-6 lg:p-8 flex flex-col justify-center">
                    <span class="text-xs text-gray-400 mb-2">
                      {projet.date}
                    </span>

                    <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-3">
                      {projet.titre}
                    </h3>

                    <p class="text-sm text-gray-500 leading-relaxed mb-4 line-clamp-3">
                      {projet.description}
                    </p>

                    <div class="flex items-center gap-3">
                      <span class="inline-flex items-center text-xs font-medium text-gray-500 bg-gray-100 px-3 py-1 rounded-full">
                        {projet.statutDetail}
                      </span>
                    </div>

                    <div class="mt-5">
                      <a
                        href={`/projets/${projet.slug}`}
                        class="inline-flex items-center gap-1.5 text-sm font-semibold text-green-700 hover:text-green-900 transition-colors"
                      >
                        Découvrir le projet
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"
                          />
                        </svg>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Layout>
