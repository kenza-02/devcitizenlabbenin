---
import Layout from "~/layouts/PageLayout.astro";
import { getAllRapports } from "~/utils/api";
import { FaFilePdf, FaDownload, FaCalendarAlt, FaArrowLeft, FaExternalLinkAlt } from "react-icons/fa";

interface RapportPost {
  slug: string;
  date: string;
  rapport: {
    titre: string;
    description: string;
    fichier: {
      mediaItemUrl: string;
      altText: string;
    } | null;
  };
  featuredImage: {
    node: {
      mediaItemUrl: string;
    };
  } | null;
}

export async function getStaticPaths() {
  const rapports = await getAllRapports();
  return rapports.map((post: RapportPost) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: RapportPost };
const fichierUrl = post.rapport?.fichier?.mediaItemUrl || "";
const isPdf = fichierUrl.toLowerCase().endsWith(".pdf");

const metadata = {
  title: post.rapport?.titre || "Rapport",
};
---

<Layout metadata={metadata}>
  <section class="py-12 px-6 md:px-10 max-w-5xl mx-auto">
    {/* Retour à la liste */}
    <a
      href="/rapports"
      class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-green-800 transition-colors mb-6"
    >
      <FaArrowLeft className="w-3 h-3" />
      Retour aux rapports
    </a>

    {/* En-tête */}
    <div class="bg-green-50 border border-green-200 rounded-xl p-6 mb-6 flex flex-col md:flex-row md:items-center gap-4">
      <div class="w-14 h-14 min-w-[56px] rounded-lg bg-green-100 flex items-center justify-center text-green-800">
        <FaFilePdf className="w-7 h-7" />
      </div>

      <div class="flex-1">
        <h1 class="text-xl md:text-2xl font-semibold text-gray-900 leading-tight mb-2">
          {post.rapport?.titre}
        </h1>
        <span class="inline-flex items-center gap-1.5 text-sm text-green-700">
          <FaCalendarAlt className="w-3.5 h-3.5" />
          {new Date(post.date).toLocaleDateString("fr-FR", {
            day: "numeric",
            month: "long",
            year: "numeric",
          })}
        </span>
      </div>

      {fichierUrl && (
        <a
          href={fichierUrl}
          target="_blank"
          rel="noopener noreferrer"
          download
          class="inline-flex items-center gap-2 text-sm font-medium text-white bg-green-600 hover:bg-green-800 px-5 py-2.5 rounded-lg transition-colors duration-200 self-start md:self-center"
        >
          <FaDownload className="w-4 h-4" />
          Télécharger
        </a>
      )}
    </div>

    {/* Description */}
    <div class="mb-6">
      <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-2">
        Description
      </p>
      <p class="text-sm text-gray-700 leading-relaxed whitespace-pre-line">
        {post.rapport?.description}
      </p>
    </div>

    {/* Lecteur de document */}
    {fichierUrl && (
      <div class="border border-gray-200 rounded-xl overflow-hidden">
        <div class="bg-gray-50 px-4 py-3 border-b border-gray-200 flex items-center justify-between">
          <span class="inline-flex items-center gap-2 text-sm text-gray-500">
            <FaFilePdf className="w-4 h-4" />
            Lecteur du document
          </span>
          <a
            href={fichierUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-medium text-white bg-green-600 hover:bg-green-800 px-3.5 py-1.5 rounded-lg transition-colors duration-200"
          >
            <FaExternalLinkAlt className="w-3 h-3" />
            Ouvrir
          </a>
        </div>

        {isPdf ? (
          <iframe
            src={fichierUrl}
            class="w-full border-0"
            style="height: 80vh;"
            title={post.rapport?.titre}
          />
        ) : (
          <div class="py-16 text-center text-gray-400">
            <FaFilePdf className="w-12 h-12 mx-auto mb-4" />
            <p class="mb-3">Aperçu non disponible pour ce type de fichier.</p>
            <a
              href={fichierUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-green-600 hover:text-green-800 font-medium underline text-sm"
            >
              Ouvrir le document
            </a>
          </div>
        )}
      </div>
    )}
  </section>
</Layout>