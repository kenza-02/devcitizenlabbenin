---
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import baniereImage from '../assets/images/baniere.png';

const metadata = {
  title: "Questions Fréquentes - AfricTivistes CitizenLab Bénin",
  description: "Vous trouverez ici les réponses aux questions les plus posées sur CitizenLab Bénin, nos formations et nos activités.",
  ignoreTitleTemplate: true,
};

const questions = [
  {
    question: "Qu'est-ce que le projet AfricTivistes CitizenLab Bénin ?",
    reponse:
      "AfricTivistes CitizenLab Benin est une fabrique citoyenne qui a pour objectif d’appuyer, d’accompagner et d’outiller les acteurs de la société civile du Bénin par la formation, le développement d’outils innovants.",
  },
  {
    question: "Qu'est-ce que la Civic Tech ?",
    reponse:
      "La Civic Tech est un terme qui désigne les technologies et les démarches qui favorisent et renforcent le rôle joué par les citoyens dans la consolidation des débats publics. Ils sont souvent utilisées par les jeunes pour s'engager politiquement et participer à la vie de leur pays",
  },
  {
    question: "Pourquoi AfricTivistes CitizenLab Benin encourage la participation citoyenne au Bénin ?",
    reponse:
      "AfricTivistes CitizenLab est une initiative de Promotion de la Participation Citoyenne et de de l’engagement civique et politique des jeunes du Bénin est une réponse à une demande des jeunes et des organisations de la société civile.",
  },
  {
    question: "Comment les Civic Tech ont-elles permis des mobilisations importantes en Afrique ?",
    reponse:
      "Les Civic Tech ont permis des mobilisations importantes en Afrique en donnant une voix aux citoyens et en permettant des échanges d'informations en temps réel. Elles ont notamment été utilisées lors des campagnes électorales et pour organiser des manifestations et des protestations",
  },
  {
    question: "Comment AfricTivistes CitizenLab Benin encourage la participation citoyenne au Bénin ?",
    reponse:
      "Le projet compte passer par la production de contenus, le plaidoyer et la formation pour encourager la participation citoyenne au Bénin.",
  },
  {
    question: "Comment les Civic Tech ont-elles permis des mobilisations importantes en Afrique ?",
    reponse:
      "Les Civic Tech ont permis des mobilisations importantes en Afrique en donnant une voix aux citoyens et en permettant des échanges d'informations en temps réel. Elles ont notamment été utilisées lors des campagnes électorales et pour organiser des manifestations et des protestations",
  },
];
---

<Layout metadata={metadata}>
  <!-- Bannière FAQ avec image de fond -->
  <div class="relative">
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 to-black/60 z-10"></div>
    <div class="absolute inset-0">
      <Image 
        src={baniereImage}
        alt="CitizenLab Bénin FAQ" 
        width={1920} 
        height={800} 
        class="w-full h-full object-cover"
      />
    </div>
    <div class="relative z-20 py-32 md:py-40 lg:py-48 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center text-white">
      <div class="text-center">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-4">Questions Fréquentes</h1>
        <div class="h-1 w-[500px] max-w-full bg-white mx-auto mb-8"></div>
      </div>
      <p class="text-xl md:text-2xl lg:text-3xl max-w-4xl mx-auto">
        Vous trouverez ici les réponses aux questions les plus posées sur CitizenLab Bénin, nos formations et nos activités.
      </p>
    </div>
  </div>

  <!-- Section FAQ -->
  <div class="bg-white py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Titre FAQ -->
    <h2 class="text-5xl font-bold text-center mb-10 text-gray-900">FAQ</h2>
    <div class="h-1 w-72 max-w-full bg-gradient-to-r from-green-600 via-yellow-400 to-red-600 mx-auto mb-10"></div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      {questions.map((item, index) => (
        <div class="faq-item" data-index={index}>
          <div
            class={`faq-question border-b border-gray-200 py-4 px-6 hover:bg-gray-50 rounded-md ${
              index % 3 === 0
                ? 'border-l-4 border-green-600'
                : index % 3 === 1
                  ? 'border-l-4 border-yellow-500'
                  : 'border-l-4 border-red-600'
            }`}
          >
            <h4 class="text-lg font-semibold text-gray-900 flex items-center">
              <span
                class={`faq-arrow mr-3 text-2xl ${
                  index % 3 === 0 ? 'text-green-600' : index % 3 === 1 ? 'text-yellow-500' : 'text-red-600'
                }`}
              >
                ➔
              </span>
              {item.question}
            </h4>
            <div class="faq-answer bg-white mt-3 pl-8 pr-2">
              <p class="text-gray-600">{item.reponse}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Initialiser toutes les réponses comme cachées
    const faqAnswers = document.querySelectorAll('.faq-answer');
    faqAnswers.forEach(answer => {
      answer.style.display = 'none';
    });
    
    // Gestion du survol pour afficher/masquer les réponses
    const faqQuestions = document.querySelectorAll('.faq-question');
    
    faqQuestions.forEach(question => {
      // Afficher la réponse au survol
      question.addEventListener('mouseenter', function() {
        const answer = this.querySelector('.faq-answer');
        answer.style.display = 'block';
        
        // Rotation de la flèche
        const arrow = this.querySelector('.faq-arrow');
        arrow.style.transform = 'rotate(90deg)';
      });
      
      // Masquer la réponse quand la souris quitte
      question.addEventListener('mouseleave', function() {
        const answer = this.querySelector('.faq-answer');
        answer.style.display = 'none';
        
        // Rotation de la flèche
        const arrow = this.querySelector('.faq-arrow');
        arrow.style.transform = 'rotate(0deg)';
      });
      
      // Pour les appareils mobiles (tactiles), ajouter un événement de clic
      question.addEventListener('click', function() {
        // Vérifier si nous sommes sur un appareil tactile
        if (window.matchMedia('(max-width: 768px)').matches) {
          const answer = this.querySelector('.faq-answer');
          const arrow = this.querySelector('.faq-arrow');
          
          if (answer.style.display === 'none') {
            answer.style.display = 'block';
            arrow.style.transform = 'rotate(90deg)';
          } else {
            answer.style.display = 'none';
            arrow.style.transform = 'rotate(0deg)';
          }
        }
      });
    });
    
  });
</script>

<style>
  .faq-arrow {
    transition: transform 0.3s ease;
  }
  
  .faq-answer {
    transition: opacity 0.3s ease;
  }
  
  .faq-item {
    border-bottom: 1px solid #e5e7eb;
  }
  
  .faq-item:last-child {
    border-bottom: none;
  }
  
  /* Styles pour les appareils mobiles */
  @media (max-width: 768px) {
    .faq-question {
      cursor: pointer;
    }
  }
</style>